    "/api/media": {
      "post": {
        "tags": [
          "Media"
        ],
        "summary": "Upload encrypted media file",
        "description": "Uploads an end-to-end encrypted media file bound to the receiver. The server stores only the ciphertext. Returns the media id.",
        "operationId": "UploadMedia",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "The encrypted media blob (nonce || mac || ciphertext). Its field name must be file.",
                    "format": "binary"
                  },
                  "receiverId": {
                    "type": "string",
                    "description": "Id of the user the media is sent to.",
                    "format": "uuid"
                  }
                },
                "required": [
                  "file",
                  "receiverId"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsMediaUploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                },
                "example": {
                  "error": "..."
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                },
                "example": {
                  "error": "..."
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                },
                "example": {
                  "error": "..."
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                },
                "example": {
                  "error": "..."
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
